APP_NAME="Registro de Entradas y Salidas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Caracas
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Cada quien pone aquí los datos de SU base local.
# Este archivo es solo la plantilla: el .env real nunca se sube al repositorio.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=registro_accesos
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# El sistema de carnets, de donde se traen las fotos del personal al darlo de alta.
# En la misma máquina, la carpeta de sus fotos. En red, la URL base:
#   CARNETS_FOTOS="/var/www/carnets/public/imgs/usuarios"
#   CARNETS_FOTOS="http://172.17.1.23:8000/imgs/usuarios"
CARNETS_FOTOS=

# Dirección base del sistema de carnets para verificar un QR (su API pública). Es la que hay que
# cambiar cuando carnets se muda de IP o sale a la calle con un dominio:
#   CARNETS_URL="http://172.17.1.23:8000"
#   CARNETS_URL="https://carnets.ciip.com.ve"
CARNETS_URL=
CARNETS_TIMEOUT=4

# La base del sistema de carnets, SOLO para sembrar el personal del edificio de una vez
# (php artisan db:seed --class=Database\Seeders\TrabajadoresDesdeCarnetsSeeder). Déjala vacía si
# no se va a sembrar desde ahí. Host/puerto/usuario/clave caen a los de DB_* si no se ponen.
CARNETS_DB_HOST=127.0.0.1
CARNETS_DB_PORT=5432
CARNETS_DB_DATABASE=carnet_ciip
CARNETS_DB_USERNAME=postgres
CARNETS_DB_PASSWORD=postgres
