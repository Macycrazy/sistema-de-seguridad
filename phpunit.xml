<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        La exportación a Excel arma el archivo en memoria y se pasa de los 128 MB que trae PHP por
        omisión: la prueba del reporte del día moría con «Allowed memory size exhausted», y con
        ella el proceso entero. Se sube aquí para que no haya que acordarse de pasarle un «-d» a
        cada quien.
    -->
    <ini name="memory_limit" value="1G"/>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            LAS PRUEBAS CORREN EN POSTGRESQL, igual que el sistema.

            Antes corrían en un SQLite en memoria. Era más rápido, pero probaba otra base distinta
            de la de producción, y eso ya costó caro: consultas que pasaban en verde y reventaban
            en el servidor, y al revés — sintaxis de Postgres que tumbaba 67 pruebas sin que nada
            estuviera mal en el sistema. Peor todavía, un lower() que en una base casaba los
            acentos y en la otra no, y creaba unidades duplicadas sin decir nada.

            Solo se fija la CONEXIÓN y el NOMBRE de la base. El servidor, el puerto y las
            credenciales salen del .env de cada quien, que ya los tiene puestos para el sistema.

            Hay que crear esa base UNA vez, y está vacía a propósito: cada prueba la migra y la
            deja como estaba. Nunca toca «registro_accesos», que es la de trabajar.

                createdb -h 127.0.0.1 -p 5433 -U tu_usuario registro_accesos_pruebas
        -->
        <!--
            El enlace con el sistema de carnets, APAGADO en las pruebas.

            Sin esto, una prueba cambia de resultado según lo que tenga en su .env quien la corra:
            con CARNETS_TOKEN puesto, el código pide las fotos a la API de verdad —que ni responde
            desde una máquina de desarrollo ni debe responder— y la prueba falla sin que nada esté
            roto. Cada prueba pone con «config()» la vía que quiere probar.
        -->
        <env name="CARNETS_TOKEN" value=""/>
        <env name="CARNETS_URL" value=""/>
        <env name="CARNETS_API" value=""/>
        <env name="CARNETS_FOTOS" value=""/>

        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="registro_accesos_pruebas"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
